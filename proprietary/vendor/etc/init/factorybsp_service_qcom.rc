service interfaces.factoryInterface-V1-service /vendor/bin/hw/interfaces.factoryInterface-V1-service
    class late_start
    user system
    group root system nfc sdcard_rw sdcard_r media_rw oem_2901 vendor_qti_diag
    seclabel u:r:factory_services:s0

#for wlan and bt ftmdaemon test
on property:vendor.ptt_ffbm_bt=start
    start ffbm_bt

on property:vendor.ptt_ffbm_bt=stop
    stop ffbm_bt

on property:vendor.ptt_ffbm_wifi=start
    #ifconfig wlan0 up
    write /sys/module/wlan/parameters/con_mode 5
    #SM6450+WCN3988 for plan
    write /sys/module/adrastea/parameters/con_mode 5
    #SM6450+WCN6750 for plan
    write /sys/module/qca6750/parameters/con_mode 5
    # WCN6755
    write /sys/module/qca_cld3_qca6750/parameters/con_mode 5
    # WCN3988
    write /sys/module/qca_cld3_adrastea/parameters/con_mode 5
    start ffbm_wifi

on property:vendor.ptt_ffbm_wifi=stop
    write /sys/module/wlan/parameters/con_mode 0
    #SM6450+WCN3988 for plan
    write /sys/module/adrastea/parameters/con_mode 0
    #SM6450+WCN6750 for plan
    write /sys/module/qca6750/parameters/con_mode 0
    # WCN6755
    write /sys/module/qca_cld3_qca6750/parameters/con_mode 0
    # WCN3988
    write /sys/module/qca_cld3_adrastea/parameters/con_mode 0
    stop ffbm_wifi

service ffbm_bt /vendor/bin/ftmdaemon -n -dd
    user system
    group system
    seclabel u:r:hal_bluetooth_default:s0
    disabled

service ffbm_wifi /vendor/bin/ftmdaemon -n -dd
    user root
    group system vendor_qti_diag
    disabled

