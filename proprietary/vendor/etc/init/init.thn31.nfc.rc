on boot
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
    mkdir /data/vendor 0777 nfc nfc
    mkdir /data/vendor/nfc 0777 nfc nfc
    mkdir /data/vendor/nfc/param 0777 nfc nfc
    wait /dev/tms_nfc
    chmod 0660 /dev/tms_nfc
    chown nfc nfc /dev/tms_nfc
    chown nfc nfc /sys/nfc/chip_name
    chmod 0664 /proc/tmsdev/shutdown
    chown nfc nfc /proc/tmsdev/shutdown

#one bianry
#leeds S88015AA1-glo S88115AA1-cn S88115JA1-india S88115SA1-india poco
#LEEDS S88015AA1 support nfc 
on early-init && property:ro.boot.hwc=Global && property:ro.boot.multisim=dsds
    setprop ro.boot.product.hardware.sku hcesim_dsds
on early-init && property:ro.boot.hwc=Global && property:ro.boot.multisim=ssss
    setprop ro.boot.product.hardware.sku hcesim_ssss
on early-init && property:ro.boot.hwc=India && property:ro.boot.multisim=dsds
    setprop ro.boot.product.hardware.sku nonfc_dsds
on early-init && property:ro.boot.hwc=India && property:ro.boot.multisim=ssss
    setprop ro.boot.product.hardware.sku nonfc_ssss
on early-init && property:ro.boot.hwc=CN && property:ro.boot.multisim=dsds
    setprop ro.boot.product.hardware.sku hcesimese_dsds
on early-init && property:ro.boot.hwc=CN && property:ro.boot.multisim=ssss
    setprop ro.boot.product.hardware.sku hcesimese_ssss
