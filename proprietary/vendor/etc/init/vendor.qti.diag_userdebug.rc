on early-init
    chown system system /sys/devices/soc0/select_image
    chown system system /sys/devices/soc0/image_version
    chown system system /sys/devices/soc0/image_variant
    chown system system /sys/devices/soc0/image_crm_version

on early-boot
    chown system system /sys/bus/coresight/devices/coresight-tmc-etf/curr_sink
    chown system system /sys/bus/coresight/devices/coresight-tmc-etf/enable_sink
    chown system system /sys/bus/coresight/devices/coresight-tmc-etr/curr_sink
    chown system system /sys/bus/coresight/devices/coresight-tmc-etr/enable_sink
    chown system system /sys/bus/coresight/devices/coresight-tmc-etr/out_mode
    chown root oem_2901 /sys/bus/coresight/devices/coresight-tmc-etr/enable_sink
    chown root oem_2901 /sys/bus/coresight/devices/coresight-tmc-etr/out_mode
    chown system system /sys/bus/coresight/devices/coresight-tpiu/curr_sink
    chown system system /sys/bus/coresight/devices/coresight-tpiu/out_mode
    chown system system /sys/bus/coresight/devices/coresight-stm/enable
    chown system system /sys/bus/coresight/devices/coresight-stm/enable_source
    chown root oem_2901 /sys/bus/coresight/devices/coresight-stm/enable_source
    chown system system /sys/bus/coresight/devices/coresight-hwevent/enable
    chown system system /sys/bus/coresight/devices/coresight-stm/hwevent_enable
    chown system system /sys/bus/coresight/devices/coresight-hwevent/setreg
    chown system system /sys/bus/coresight/devices/coresight-swao-csr/timestamp
    chown system system /sys/bus/coresight/devices/coresight-modem-diag/enable_source
    chown system system /sys/bus/coresight/devices/coresight-tmc-etr1/enable_sink
    chown system system /sys/bus/coresight/devices/coresight-tmc-etr1/out_mode
    chown system system /sys/bus/coresight/reset_source_sink

on boot
    chown system system sys/bus/coresight/devices/stm0/enable_source
    chmod 664 sys/bus/coresight/devices/stm0/enable_source
    chown root oem_2902 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/enable_sink
    chmod 660 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/enable_sink
    chown system system /sys/bus/coresight/devices/tmc_etr0/enable_sink
    chmod 664 /sys/bus/coresight/devices/tmc_etr0/enable_sink
    chown root oem_2902 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/out_mode
    chmod 660 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/out_mode
    chown system system /sys/bus/coresight/devices/tmc_etr0/out_mode
    chmod 664 /sys/bus/coresight/devices/tmc_etr0/out_mode
    chown root oem_2902 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/block_size
    chmod 660 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/block_size
    chown root oem_2902 /sys/bus/coresight/devices/tmc_etr0/block_size
    chmod 664 /sys/bus/coresight/devices/tmc_etr0/block_size
    chown root oem_2902 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/buffer_size
    chmod 660 /sys/devices/platform/soc/8048000.tmc/tmc_etr0/buffer_size
    chown root oem_2902 /sys/bus/coresight/devices/tmc_etr0/buffer_size
    chmod 664 /sys/bus/coresight/devices/tmc_etr0/buffer_size
    chown system system /sys/bus/coresight/devices/modem_diag/enable_source
    chmod 666 /sys/devices/platform/soc/soc:modem_diag/modem_diag/enable_source
    chown system system /sys/bus/coresight/devices/modem_diag
    chmod 664 /sys/bus/coresight/devices/modem_diag
    chown root oem_2902 /sys/bus/coresight/reset_source_sink
    chmod 660 /sys/bus/coresight/reset_source_sink
    start vendor.diag-router

service vendor.diag-router /vendor/bin/diag-router
    class hal
    user system
    group system
    capabilities KILL
    disabled

