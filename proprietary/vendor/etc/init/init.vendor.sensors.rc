on early-boot

    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_list.txt
    chown system system /mnt/vendor/persist/sensors/odp
    chown system system /mnt/vendor/persist/sensors/odp/sns_odp_version
    chown system system /mnt/vendor/persist/sensors/hub1
    chown system system /mnt/vendor/persist/sensors/hub2
    chown system system /mnt/vendor/persist/sensors/hub1/sensors
    chown system system /mnt/vendor/persist/sensors/hub2/sensors
    chown system system /mnt/vendor/persist/sensors/registry
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/registry
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_config
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/registry/config
    chown system system /mnt/vendor/persist/sensors/hub1/sensors/registry/config
    chown system system /mnt/vendor/persist/sensors/hub2/sensors/registry/config
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings
    chmod 0664 /mnt/vendor/persist/sensors/hub1/sensors/sensors_settings
    chmod 0664 /mnt/vendor/persist/sensors/hub2/sensors/sensors_settings

    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_default_sensors.json.default_sensors.sensor_temperature
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_default_sensors.json.default_sensors.sensor_temperature.attr_0
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_default_sensors.json.default_sensors.sensor_temperature.attr_1
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.amd
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.amd.attr_0
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.amd.attr_1
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.tilt
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.tilt.attr_0
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_qrd_default_sensors.json.default_sensors.tilt.attr_1

    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0.mag
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0.mag.config
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0.mag.config_2
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.config
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp.11v3a
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp.5v2a
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp.5v4a
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp.9v2a
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.charging_comp.mode
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal.bias
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal.corr_mat
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal_2
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal_2.bias
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.mag.fac_cal_2.corr_mat
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.orient
    rm /mnt/vendor/persist/sensors/registry/registry/aldabra_och191x_0_1.json.och191x_0_platform.placement

    start vendor.sensors
    chown system system /sys/kernel/boot_adsp/ssr

